{
  "name": "twitter-guest-mcp",
  "version": "0.1.0",
  "description": "MCP server that reads public tweets via Twitter/X's guest token flow — no API key, no account",
  "type": "module",
  "bin": {
    "twitter-guest-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sparkyfen/twitter-guest-mcp.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "twitter",
    "x",
    "guest-token"
  ],
  "scripts": {
    "prepublishOnly": "npm run build",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:live": "LIVE=1 vitest run test/live.test.ts",
    "start": "node dist/index.js"
  },
  "engines": {
    "node": ">=18.17"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
